# Copy this file to .env for local environment-variable overrides.
# Never commit a real .env file or any real secret values.
SECRET_KEY=replace-with-a-long-random-secret
# Leave DATABASE_URL unset for local SQLite development.
# For hosted deployment, use the Neon connection string with SSL enabled.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Hosted database seeding is disabled by default. Set true only for the first
# deployment if you want to create the sample restaurants, employees, orders,
# reviews, and demo accounts. Use strong, unique passwords for the accounts.
# SEED_DEMO_DATA=true
# DEMO_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# DEMO_MANAGER_PASSWORD=replace-with-a-unique-strong-password
# DEMO_CUSTOMER_PASSWORD=replace-with-a-unique-strong-password
